{
  "name": "oatrix-lab",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "A bounded deterministic laboratory for an industrial shared reality",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "demo": "node scripts/demo.mjs",
    "start": "node scripts/serve.mjs",
    "build:web": "node scripts/build-web.mjs",
    "check": "node scripts/check.mjs",
    "test:e2e": "node --test e2e/hosts.e2e.mjs e2e/mandates.e2e.mjs e2e/signer.e2e.mjs e2e/durable.e2e.mjs",
    "recipe:check": "node scripts/recipe-check.mjs",
    "verify": "npm run check && npm test && npm run test:e2e && npm run demo && npm run demo:work && npm run demo:signer && npm run demo:durable && npm run sweep && npm run sweep:verify && npm run build:web",
    "sweep": "node scripts/sweep.mjs",
    "sweep:verify": "node scripts/sweep-verify.mjs",
    "demo:work": "node scripts/work-demo.mjs",
    "demo:signer": "node scripts/signer-demo.mjs",
    "demo:durable": "node scripts/durable-demo.mjs",
    "start:durable": "node scripts/serve-durable.mjs",
    "ledger:init": "node scripts/ledger.mjs init",
    "ledger:check": "node scripts/ledger.mjs check",
    "ledger:checkpoint": "node scripts/ledger.mjs checkpoint",
    "ledger:export": "node scripts/ledger.mjs export",
    "ledger:restore": "node scripts/ledger.mjs restore"
  }
}
